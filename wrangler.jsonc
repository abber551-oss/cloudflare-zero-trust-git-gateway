{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-trust-git-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "default"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "audit_ledger",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEDGER_SEQUENCER",
        "class_name": "LedgerSequencer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LedgerSequencer"]
    }
  ]
}
